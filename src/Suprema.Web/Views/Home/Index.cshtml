@model HomeViewModel
@{
    ViewData["Title"] = "Home";
    ViewData[“MetaDescription”] = “Suprema South Africa - authorised partner for Suprema biometric access control and time &amp; attendance solutions. Delivered and supported locally across South Africa.”;

    var productImages = new System.Collections.Generic.Dictionary<string, string>
    {
        ["xstation-2"]    = "/assets/products/xstation-2.webp",
        ["biostation-3"]  = "/assets/products/biostation-3.webp",
        ["bioentry-w3"]   = "/assets/products/bioentry-w3.webp",
        ["biostation-a2"] = "/assets/products/biostation-a2.png",
        ["facestation-2"] = "/assets/products/facestation-2.png",
        ["biomini-plus-2"]= "/assets/products/biomini-plus-2.png",
        ["biomini-slim-3"]= "/assets/products/biomini-slim-3.png"
    };
}

@* â”€â”€ Hero â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ *@
<section class="hero">
  <div class="container">
    <div class="row align-items-center g-5" style="min-height:calc(90vh - 80px);">
      <div class="col-lg-6 py-5">
        <div class="reveal">
          <span class="badge mb-3 px-3 py-2 rounded-pill"
                style="background:rgba(255,255,255,.1);color:rgba(255,255,255,.85);font-weight:500;font-size:.8rem;letter-spacing:.06em;text-transform:uppercase;">
            Authorised Suprema Partner &mdash; South Africa
          </span>
          <h1>Biometric Security,<br><em>Built for South Africa</em></h1>
          <p class="lead mt-3">
            Suprema's world-class access control and time &amp; attendance solutions â€”
            delivered and supported locally by our expert team.
          </p>
          <div class="d-flex flex-wrap gap-3 mt-5">
            <a class="btn-suprema" asp-controller="Contact" asp-action="Index">@L["Nav.RequestQuote"]</a>
            <a class="btn-outline-white" asp-controller="Products" asp-action="Index">Explore Products</a>
          </div>
        </div>
      </div>
      <div class="col-lg-6 d-none d-lg-flex justify-content-center">
        <div class="hero-img-panel reveal reveal-delay-2" style="width:100%;">
          <img src="/assets/products/xstation-2.png" alt="Suprema XStation 2 biometric reader" />
        </div>
      </div>
    </div>
  </div>
</section>

@* â”€â”€ Product categories â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ *@
<section class="section-lg section-light">
  <div class="container">
    <div class="text-center mb-5 reveal">
      <div class="section-divider"></div>
      <h2 class="section-title">@L["Home.Categories"]</h2>
      <p class="section-subtitle">Enterprise-grade biometric hardware across three specialised product lines</p>
    </div>
    <div class="row g-4 justify-content-center">
      @{
        var catIcons = new[] { "/assets/icons/ico-face-id.svg", "/assets/icons/ico-server-off.svg", "/assets/icons/ico-building.svg" };
        int ci = 0;
      }
      @foreach (var cat in Model.Categories)
      {
        <div class="col-md-4 reveal reveal-delay-@(ci + 1)">
          <a href="/products/@cat.Slug" class="text-decoration-none">
            <div class="card-category">
              <div class="cat-icon">
                <img src="@catIcons[ci % catIcons.Length]" alt="" />
              </div>
              <h5 class="fw-bold mb-2" style="color:var(--sup-text);">@cat.Name</h5>
              <p class="mb-3" style="color:var(--sup-muted);font-size:.9rem;font-weight:300;">@cat.Description</p>
              <span class="btn-outline-suprema btn-sm">@L["Common.LearnMore"]</span>
            </div>
          </a>
        </div>
        ci++;
      }
    </div>
  </div>
</section>

@* â”€â”€ Featured products â€” Swiper â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ *@
@if (Model.FeaturedProducts.Count > 0)
{
  <section class="section-lg">
    <div class="container">
      <div class="d-flex justify-content-between align-items-end mb-5 reveal">
        <div>
          <div class="section-divider"></div>
          <h2 class="section-title mb-0">@L["Home.FeaturedProducts"]</h2>
        </div>
        <a class="btn-outline-suprema btn-sm d-none d-md-inline-flex"
           asp-controller="Products" asp-action="Index">@L["Common.ViewAll"] Products</a>
      </div>

      <div class="swiper products-swiper">
        <div class="swiper-wrapper pb-4">
          @foreach (var product in Model.FeaturedProducts)
          {
            var imgSrc = productImages.TryGetValue(product.Slug, out var img) ? img : "";
            <div class="swiper-slide">
              <div class="card card-product h-100">
                <div class="card-img-top">
                  @if (!string.IsNullOrEmpty(imgSrc))
                  {
                    <img src="@imgSrc" alt="@product.Name" />
                  }
                  else
                  {
                    <span class="text-muted small" style="opacity:.5;">@product.Name</span>
                  }
                </div>
                <div class="card-body px-3 pt-3 pb-2">
                  <span class="card-tag mb-2 d-inline-block">@product.CategorySlug.Replace("-", " ")</span>
                  <h5 class="card-title">@product.Name</h5>
                  <p class="mb-0" style="font-size:.85rem;color:var(--sup-muted);font-weight:300;">@product.TagLine</p>
                </div>
                <div class="card-footer bg-transparent border-0 px-3 pb-3">
                  <a href="/products/@product.CategorySlug/@product.Slug"
                     class="btn-outline-suprema btn-sm w-100 justify-content-center">@L["Common.LearnMore"]</a>
                </div>
              </div>
            </div>
          }
        </div>
        <div class="swiper-pagination mt-2"></div>
        <div class="swiper-button-prev"></div>
        <div class="swiper-button-next"></div>
      </div>

      <div class="text-center mt-4 d-md-none">
        <a class="btn-suprema" asp-controller="Products" asp-action="Index">@L["Common.ViewAll"] Products</a>
      </div>
    </div>
  </section>
}

@* â”€â”€ Solutions â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ *@
<section class="section-lg" style="background: var(--sup-dark-2); background-image: url('/assets/images/section02-bg.jpg'); background-size:cover; background-position:center; position:relative;">
  <div style="position:absolute;inset:0;background:rgba(23,23,42,.85);"></div>
  <div class="container" style="position:relative;z-index:1;">
    <div class="text-center mb-5 reveal">
      <div class="section-divider"></div>
      <h2 class="section-title light">@L["Home.Solutions"]</h2>
      <p class="section-subtitle light">Tailored biometric deployments for every sector</p>
    </div>
    <div class="row g-4 justify-content-center">
      @{int si = 0;}
      @foreach (var sol in Model.Solutions)
      {
        <div class="col-md-6 col-lg-4 reveal reveal-delay-@((si % 3) + 1)">
          <a href="/solutions/@sol.Slug" class="text-decoration-none">
            <div class="card h-100 text-center p-4"
                 style="background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:12px;transition:background .3s,transform .3s;"
                 onmouseover="this.style.background='rgba(161,41,68,.18)';this.style.transform='translateY(-4px)'"
                 onmouseout="this.style.background='rgba(255,255,255,.05)';this.style.transform=''">
              <h5 class="fw-bold mb-2" style="color:var(--sup-white);">@sol.Name</h5>
              <p class="mb-3" style="color:rgba(255,255,255,.65);font-size:.88rem;font-weight:300;">@sol.TagLine</p>
              <span class="btn-outline-white btn-sm">@L["Common.LearnMore"]</span>
            </div>
          </a>
        </div>
        si++;
      }
    </div>
  </div>
</section>

@* â”€â”€ Latest news â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ *@
@if (Model.LatestArticles.Count > 0)
{
  <section class="section-lg section-light">
    <div class="container">
      <div class="d-flex justify-content-between align-items-end mb-5 reveal">
        <div>
          <div class="section-divider"></div>
          <h2 class="section-title mb-0">@L["Home.LatestNews"]</h2>
        </div>
        <a class="btn-outline-suprema btn-sm d-none d-md-inline-flex"
           asp-controller="News" asp-action="Index">@L["Common.ViewAll"]</a>
      </div>
      <div class="row g-4">
        @{int ni = 0;}
        @foreach (var article in Model.LatestArticles)
        {
          <div class="col-md-4 reveal reveal-delay-@(ni + 1)">
            <div class="card h-100" style="border:1px solid var(--sup-border-light);border-radius:12px;overflow:hidden;">
              <div class="card-body p-4">
                <p class="mb-2" style="font-size:.78rem;color:var(--sup-primary);font-weight:600;text-transform:uppercase;letter-spacing:.06em;">
                  @article.PublishedUtc.ToString("d MMMM yyyy")
                </p>
                <h6 class="fw-bold mb-2" style="font-size:1rem;line-height:1.4;">@article.Title</h6>
                <p style="color:var(--sup-muted);font-size:.88rem;font-weight:300;line-height:1.7;">@article.Excerpt</p>
              </div>
              <div class="card-footer bg-transparent border-0 px-4 pb-4">
                <a href="/news/@article.Slug" class="btn-outline-suprema btn-sm">@L["News.ReadMore"]</a>
              </div>
            </div>
          </div>
          ni++;
        }
      </div>
    </div>
  </section>
}

@* â”€â”€ CTA strip â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ *@
<section class="cta-strip section-md text-center text-white">
  <div class="container reveal">
    <h3 class="fw-bold mb-3" style="font-size:clamp(1.6rem,3vw,2.4rem);letter-spacing:-0.03em;">
      Ready to secure your organisation?
    </h3>
    <p class="mb-5" style="opacity:.75;font-weight:300;font-size:1.1rem;max-width:540px;margin:0 auto 2.5rem;">
      Talk to our South Africa team about access control, time &amp; attendance,
      or a full biometric deployment â€” we respond within one business day.
    </p>
    <div class="d-flex flex-wrap gap-3 justify-content-center">
      <a class="btn-suprema" asp-controller="Contact" asp-action="Index">@L["Nav.RequestQuote"]</a>
      <a class="btn-outline-white" asp-controller="Solutions" asp-action="Index">Explore Solutions</a>
    </div>
  </div>
</section>

