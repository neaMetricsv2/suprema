@model HomeViewModel
@{
    ViewData["Title"] = "Home";
    ViewData["MetaDescription"] = "PLACEHOLDER — homepage meta description, ~150 chars.";
}

@* ---- Hero ---- *@
<section class="hero">
  <div class="container">
    <div class="row align-items-center g-5">
      <div class="col-lg-6">
        <h1>@L["Home.HeroTitle"]</h1>
        <p class="lead">@L["Home.HeroSubtitle"]</p>
        <div class="d-flex flex-wrap gap-3 mt-4">
          <a class="btn btn-suprema btn-lg" asp-controller="Contact" asp-action="Index">@L["Nav.RequestQuote"]</a>
          <a class="btn btn-outline-light btn-lg" asp-controller="Products" asp-action="Index">@L["Common.ViewAll"] Products</a>
        </div>
      </div>
      <div class="col-lg-6 d-none d-lg-block text-center">
        @* Hero image placeholder *@
        <div class="rounded-3" style="height:320px;background:rgba(255,255,255,.08);display:flex;align-items:center;justify-content:center;">
          <span class="text-white-50">PLACEHOLDER — hero product image</span>
        </div>
      </div>
    </div>
  </div>
</section>

@* ---- Product categories ---- *@
<section class="py-5 bg-suprema-light">
  <div class="container">
    <div class="text-center mb-4">
      <div class="section-divider"></div>
      <h2 class="section-title">@L["Home.Categories"]</h2>
    </div>
    <div class="row g-4 justify-content-center">
      @foreach (var cat in Model.Categories)
      {
        <div class="col-md-4">
          <a href="/products/@cat.Slug" class="text-decoration-none">
            <div class="card card-product h-100 text-center p-4">
              <div class="feature-icon mb-2">&#128274;</div>
              <h5 class="card-title">@cat.Name</h5>
              <p class="text-muted small mb-3">@cat.Description</p>
              <span class="btn btn-outline-suprema btn-sm">@L["Common.LearnMore"]</span>
            </div>
          </a>
        </div>
      }
    </div>
  </div>
</section>

@* ---- Featured products ---- *@
@if (Model.FeaturedProducts.Count > 0)
{
  <section class="py-5">
    <div class="container">
      <div class="text-center mb-4">
        <div class="section-divider"></div>
        <h2 class="section-title">@L["Home.FeaturedProducts"]</h2>
      </div>
      <div class="row g-4">
        @foreach (var product in Model.FeaturedProducts)
        {
          <div class="col-sm-6 col-lg-3">
            <div class="card card-product h-100">
              <div class="card-img-top d-flex align-items-center justify-content-center bg-light">
                <span class="text-muted small">PLACEHOLDER image</span>
              </div>
              <div class="card-body">
                <span class="card-tag mb-2 d-inline-block">@product.CategorySlug.Replace("-", " ")</span>
                <h5 class="card-title">@product.Name</h5>
                <p class="text-muted small">@product.TagLine</p>
              </div>
              <div class="card-footer bg-transparent border-0 pb-3">
                <a href="/products/@product.CategorySlug/@product.Slug"
                   class="btn btn-outline-suprema btn-sm w-100">@L["Common.LearnMore"]</a>
              </div>
            </div>
          </div>
        }
      </div>
      <div class="text-center mt-4">
        <a class="btn btn-suprema" asp-controller="Products" asp-action="Index">@L["Common.ViewAll"] Products</a>
      </div>
    </div>
  </section>
}

@* ---- Solutions ---- *@
<section class="py-5 bg-suprema-light">
  <div class="container">
    <div class="text-center mb-4">
      <div class="section-divider"></div>
      <h2 class="section-title">@L["Home.Solutions"]</h2>
    </div>
    <div class="row g-4 justify-content-center">
      @foreach (var sol in Model.Solutions)
      {
        <div class="col-md-4 col-lg-3">
          <a href="/solutions/@sol.Slug" class="text-decoration-none">
            <div class="card card-solution h-100 text-center p-4">
              <h5 class="fw-bold text-suprema">@sol.Name</h5>
              <p class="text-muted small mb-3">@sol.TagLine</p>
              <span class="btn btn-outline-suprema btn-sm">@L["Common.LearnMore"]</span>
            </div>
          </a>
        </div>
      }
    </div>
  </div>
</section>

@* ---- Latest news ---- *@
@if (Model.LatestArticles.Count > 0)
{
  <section class="py-5">
    <div class="container">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <div class="section-divider mb-1"></div>
          <h2 class="section-title mb-0">@L["Home.LatestNews"]</h2>
        </div>
        <a class="btn btn-outline-suprema btn-sm" asp-controller="News" asp-action="Index">@L["Common.ViewAll"]</a>
      </div>
      <div class="row g-4">
        @foreach (var article in Model.LatestArticles)
        {
          <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
              <div class="card-body">
                <p class="text-muted small mb-1">@article.PublishedUtc.ToString("d MMMM yyyy")</p>
                <h6 class="fw-bold">@article.Title</h6>
                <p class="text-muted small">@article.Excerpt</p>
              </div>
              <div class="card-footer bg-transparent border-0 pb-3">
                <a href="/news/@article.Slug" class="btn btn-outline-suprema btn-sm">@L["News.ReadMore"]</a>
              </div>
            </div>
          </div>
        }
      </div>
    </div>
  </section>
}

@* ---- CTA strip ---- *@
<section class="py-5 bg-suprema">
  <div class="container text-center text-white">
    <h3 class="fw-bold mb-3">Ready to secure your organisation?</h3>
    <p class="mb-4 opacity-75">PLACEHOLDER — CTA copy from approved partner kit.</p>
    <a class="btn btn-light btn-lg me-2" asp-controller="Contact" asp-action="Index">@L["Nav.RequestQuote"]</a>
    <a class="btn btn-outline-light btn-lg" asp-controller="Solutions" asp-action="Index">Explore Solutions</a>
  </div>
</section>
