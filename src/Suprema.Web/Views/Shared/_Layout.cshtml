<!DOCTYPE html>
<html lang="en-ZA">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " | " : "")Suprema South Africa</title>

    @* SEO *@
    @if (ViewData["MetaDescription"] != null)
    {
        <meta name="description" content="@ViewData["MetaDescription"]" />
    }

    @* hreflang — en-ZA only for v1 *@
    <link rel="alternate" hreflang="en-ZA" href="https://suprema.co.za@(Context.Request.Path)" />
    <link rel="alternate" hreflang="x-default" href="https://suprema.co.za@(Context.Request.Path)" />

    @* Open Graph *@
    <meta property="og:locale"    content="en_ZA" />
    <meta property="og:site_name" content="Suprema South Africa" />
    <meta property="og:type"      content="website" />
    @if (ViewData["OgTitle"] != null)
    {
        <meta property="og:title" content="@ViewData["OgTitle"]" />
    }

    @* Stylesheets *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @* GA4 placeholder — fires only after analytics consent *@
    <script id="ga4-script" type="text/plain" data-consent="analytics">
        /* GA4 placeholder — replace with real G-XXXXXXXX tag before launch */
    </script>

    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    @await Html.PartialAsync("_Header")

    <main>
        @RenderBody()
    </main>

    @await Html.PartialAsync("_Footer")
    @await Html.PartialAsync("_CookieConsent")

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
