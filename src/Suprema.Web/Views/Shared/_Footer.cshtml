@inject Suprema.Core.Abstractions.IContentService Content
@{
    var categories = Content.GetCategories();
    var solutions  = Content.GetSolutions();
}

<footer class="site-footer">
  <div class="container">
    <div class="row g-5">

      @* Col 1 — Brand + contact *@
      <div class="col-lg-4 col-md-6">
        <p class="footer-brand-name">Suprema South Africa</p>
        <p class="footer-tagline">@L["Footer.Tagline"]</p>

        <ul class="list-unstyled mb-0" style="font-size:.88rem;line-height:1.9;">
          <li>
            <span style="color:rgba(255,255,255,.5);font-size:.75rem;text-transform:uppercase;letter-spacing:.06em;">Address</span><br/>
            Johannesburg, South Africa
          </li>
          <li class="mt-3">
            <span style="color:rgba(255,255,255,.5);font-size:.75rem;text-transform:uppercase;letter-spacing:.06em;">Email</span><br/>
            <a href="mailto:info@suprema.co.za">info@suprema.co.za</a>
          </li>
          <li class="mt-3">
            <span style="color:rgba(255,255,255,.5);font-size:.75rem;text-transform:uppercase;letter-spacing:.06em;">@L["Footer.Support"]</span><br/>
            @L["Footer.SupportHours"]
          </li>
        </ul>
      </div>

      @* Col 2 — Products *@
      <div class="col-lg-2 col-md-3 col-6">
        <h6>@L["Footer.Products"]</h6>
        <ul>
          @foreach (var cat in categories)
          {
            <li>
              <a asp-controller="Products" asp-action="Category" asp-route-category="@cat.Slug">
                @cat.Name
              </a>
            </li>
          }
          <li class="mt-1">
            <a asp-controller="Products" asp-action="Index" style="color:var(--sup-primary);">All Products &rsaquo;</a>
          </li>
        </ul>
      </div>

      @* Col 3 — Solutions *@
      <div class="col-lg-2 col-md-3 col-6">
        <h6>@L["Footer.Solutions"]</h6>
        <ul>
          @foreach (var sol in solutions)
          {
            <li>
              <a asp-controller="Solutions" asp-action="Detail" asp-route-slug="@sol.Slug">
                @sol.Name
              </a>
            </li>
          }
          <li class="mt-1">
            <a asp-controller="Solutions" asp-action="Index" style="color:var(--sup-primary);">All Solutions &rsaquo;</a>
          </li>
        </ul>
      </div>

      @* Col 4 — Company *@
      <div class="col-lg-2 col-md-3 col-6">
        <h6>@L["Footer.Company"]</h6>
        <ul class="mb-4">
          <li><a asp-controller="Pages" asp-action="Show" asp-route-slug="about">About Us</a></li>
          <li><a asp-controller="News" asp-action="Index">News</a></li>
          <li><a asp-controller="Contact" asp-action="Index">Contact Us</a></li>
        </ul>
        <h6>@L["Footer.Legal"]</h6>
        <ul>
          <li><a asp-controller="Legal" asp-action="Show" asp-route-slug="privacy-policy">Privacy Policy</a></li>
          <li><a asp-controller="Legal" asp-action="Show" asp-route-slug="cookie-policy">Cookie Policy</a></li>
          <li><a asp-controller="Legal" asp-action="Show" asp-route-slug="paia-manual">PAIA Manual</a></li>
          <li><a asp-controller="Legal" asp-action="Show" asp-route-slug="terms">Terms of Use</a></li>
        </ul>
      </div>

    </div>
  </div>

  <div class="footer-bottom">
    <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
      <span>
        &copy; @DateTime.UtcNow.Year Suprema South Africa (Pty) Ltd. @L["Footer.Rights"]
        Suprema&reg; is a trademark of Suprema Inc., South Korea.
      </span>
      <span style="color:rgba(255,255,255,.3);">
        Authorised distributor &mdash; supremainc.com
      </span>
    </div>
  </div>
</footer>
