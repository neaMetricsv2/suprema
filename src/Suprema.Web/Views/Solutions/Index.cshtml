@model IReadOnlyList<Solution>
@{
    ViewData["Title"] = "Industry Solutions";
    ViewData["MetaDescription"] = "Suprema South Africa delivers proven biometric security solutions across enterprise, healthcare, retail, education and government sectors.";
    var solImages = new System.Collections.Generic.Dictionary<string, string>
    {
        ["enterprise"]   = "/assets/images/bg_commercial.jpg",
        ["healthcare"]   = "/assets/images/bg_healthcare.jpg",
        ["retail"]       = "/assets/images/bg_commercial.jpg",
        ["education"]    = "/assets/images/bg_infrastructure.jpg",
        ["government"]   = "/assets/images/bg_datacenter.jpg"
    };
}

<section class="page-hero hero-solutions">
  <div class="container">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="breadcrumb-item active">Solutions</li>
      </ol>
    </nav>
    <h1>@L["Solutions.Title"]</h1>
    <p class="page-hero-sub">Tailored biometric deployments for every sector — from enterprise campuses to government facilities.</p>
  </div>
</section>

<section class="section-lg">
  <div class="container">
    <div class="row g-4">
      @{int si = 0;}
      @foreach (var sol in Model)
      {
        solImages.TryGetValue(sol.Slug, out var bgImg);
        <div class="col-md-6 col-lg-4 reveal reveal-delay-@((si % 3) + 1)">
          <a asp-controller="Solutions" asp-action="Detail" asp-route-slug="@sol.Slug"
             class="card-solution-grid d-block" style="min-height:300px;">
            <div class="sol-bg" style="background-image:url('@(bgImg ?? "/assets/images/section02-bg.jpg")');">
            </div>
            <div class="sol-body">
              <h5>@sol.Name</h5>
              <p>@sol.TagLine</p>
              <span class="btn-outline-white btn-sm mt-3 d-inline-flex">@L["Common.LearnMore"]</span>
            </div>
          </a>
        </div>
        si++;
      }
    </div>
  </div>
</section>
