@model ContactFormViewModel
@{
    ViewData["Title"] = L["Contact.Title"].Value;
}

<section class="page-hero">
  <div class="container">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="breadcrumb-item active">@L["Contact.Title"]</li>
      </ol>
    </nav>
    <h1>@L["Contact.Title"]</h1>
    <p class="page-hero-sub">@L["Contact.Intro"]</p>
  </div>
</section>

<section class="section-lg">
  <div class="container">
    <div class="row g-5">

      @* Contact details *@
      <div class="col-lg-4">
        <div class="reveal">
          <div class="section-divider"></div>
          <h4 class="fw-bold mb-4" style="font-size:1.3rem;">Get in touch</h4>
        </div>

        <div class="d-flex flex-column gap-4">
          <div class="reveal reveal-delay-1">
            <p style="font-size:.72rem;text-transform:uppercase;letter-spacing:.08em;color:var(--sup-primary);font-weight:600;margin-bottom:.35rem;">Address</p>
            <p style="color:var(--sup-muted);font-weight:300;line-height:1.7;margin:0;">
              Johannesburg, South Africa
            </p>
          </div>
          <div class="reveal reveal-delay-2">
            <p style="font-size:.72rem;text-transform:uppercase;letter-spacing:.08em;color:var(--sup-primary);font-weight:600;margin-bottom:.35rem;">Email</p>
            <a href="mailto:info@suprema.co.za" style="color:var(--sup-text);font-weight:500;">info@suprema.co.za</a>
          </div>
          <div class="reveal reveal-delay-3">
            <p style="font-size:.72rem;text-transform:uppercase;letter-spacing:.08em;color:var(--sup-primary);font-weight:600;margin-bottom:.35rem;">Support Hours (SAST)</p>
            <p style="color:var(--sup-muted);font-weight:300;margin:0;">@L["Footer.SupportHours"]</p>
          </div>
          <div class="reveal reveal-delay-4">
            <p style="font-size:.72rem;text-transform:uppercase;letter-spacing:.08em;color:var(--sup-primary);font-weight:600;margin-bottom:.35rem;">Technical Support</p>
            <p style="color:var(--sup-muted);font-weight:300;margin:0;">
              For product technical support, visit
              <a href="https://support.supremainc.com" target="_blank" rel="noopener" style="color:var(--sup-primary);">Suprema Global Support</a>.
            </p>
          </div>
        </div>
      </div>

      @* Contact form *@
      <div class="col-lg-7 offset-lg-1 reveal">
        <div class="contact-box">
          <div class="section-divider"></div>
          <h4 class="fw-bold mb-4" style="font-size:1.3rem;">Send us a message</h4>
          <form asp-controller="Contact" asp-action="Index" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="row g-3">
              <div class="col-sm-6">
                <label asp-for="Name" class="form-label">@L["Contact.Name"] <span class="text-danger">*</span></label>
                <input asp-for="Name" class="form-control" placeholder="Your full name" />
                <span asp-validation-for="Name" class="text-danger small"></span>
              </div>
              <div class="col-sm-6">
                <label asp-for="Email" class="form-label">@L["Contact.Email"] <span class="text-danger">*</span></label>
                <input asp-for="Email" class="form-control" placeholder="you@company.co.za" />
                <span asp-validation-for="Email" class="text-danger small"></span>
              </div>
              <div class="col-sm-6">
                <label asp-for="Phone" class="form-label">@L["Contact.Phone"]</label>
                <input asp-for="Phone" class="form-control" placeholder="+27 (0)XX XXX XXXX" />
                <span asp-validation-for="Phone" class="text-danger small"></span>
              </div>
              <div class="col-12">
                <label asp-for="Message" class="form-label">@L["Contact.Message"] <span class="text-danger">*</span></label>
                <textarea asp-for="Message" class="form-control" rows="5"
                          placeholder="Tell us about your project, site, or question..."></textarea>
                <span asp-validation-for="Message" class="text-danger small"></span>
              </div>
              <div class="col-12 mt-2">
                <button type="submit" class="btn-suprema px-5">@L["Contact.Submit"]</button>
              </div>
            </div>
          </form>
        </div>
      </div>

    </div>
  </div>
</section>

@section Scripts {
  @await Html.PartialAsync("_ValidationScriptsPartial")
}
