@{
    ViewData["Title"] = L["Contact.ThankYou"].Value;
}

<section class="page-hero">
  <div class="container">
    <h1>@L["Contact.ThankYou"]</h1>
  </div>
</section>

<section class="py-5">
  <div class="container text-center" style="max-width:560px;">
    <div class="mb-4" style="font-size:3rem;">&#10003;</div>
    <h4 class="fw-bold text-suprema mb-3">Message received</h4>
    <p class="text-muted">@L["Contact.ThankYouMsg"]</p>
    <a class="btn btn-suprema mt-3" asp-controller="Home" asp-action="Index">Back to Home</a>
  </div>
</section>
