@model Product
@inject Suprema.Core.Abstractions.IContentService Content
@{
    var cat = Content.GetCategory(Model.CategorySlug);
    ViewData["Title"] = Model.Name;
    ViewData["MetaDescription"] = Model.TagLine;
    var related = Model.RelatedSlugs
        .Select(s => Content.GetProduct(Model.CategorySlug, s))
        .Where(p => p is not null)
        .Cast<Product>()
        .ToList();
    var productImages = new System.Collections.Generic.Dictionary<string, string>
    {
        ["xstation-2"]    = "/assets/products/xstation-2.webp",
        ["biostation-3"]  = "/assets/products/biostation-3.webp",
        ["bioentry-w3"]   = "/assets/products/bioentry-w3.webp",
        ["biostation-a2"] = "/assets/products/biostation-a2.png",
        ["facestation-2"] = "/assets/products/facestation-2.png",
        ["biomini-plus-2"]= "/assets/products/biomini-plus-2.png",
        ["biomini-slim-3"]= "/assets/products/biomini-slim-3.png"
    };
    productImages.TryGetValue(Model.Slug, out var heroImg);
}

@* â”€â”€ Sub-visual hero â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ *@
<section class="page-hero">
  <div class="container">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="breadcrumb-item"><a asp-controller="Products" asp-action="Index">Products</a></li>
        @if (cat is not null)
        {
          <li class="breadcrumb-item">
            <a asp-controller="Products" asp-action="Category" asp-route-category="@cat.Slug">@cat.Name</a>
          </li>
        }
        <li class="breadcrumb-item active">@Model.Name</li>
      </ol>
    </nav>
    <h1>@Model.Name</h1>
    <p class="page-hero-sub">@Model.TagLine</p>
  </div>
</section>

@* â”€â”€ Sticky in-page nav â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ *@
<nav class="prod-sticky-nav">
  <div class="container">
    <ul>
      @if (!string.IsNullOrEmpty(Model.Summary)) { <li><a href="#overview">Overview</a></li> }
      @if (Model.Features.Count > 0)             { <li><a href="#features">Features</a></li> }
      @if (Model.Specs.Count > 0)                { <li><a href="#specifications">Specifications</a></li> }
      @if (related.Count > 0)                    { <li><a href="#related">Related Products</a></li> }
      <li><a class="btn-nav-cta ms-3" asp-controller="Contact" asp-action="Index">Request a Quote</a></li>
    </ul>
  </div>
</nav>

@* â”€â”€ Overview â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ *@
@if (!string.IsNullOrEmpty(Model.Summary))
{
  <section id="overview" class="section-lg">
    <div class="container">
      <div class="row g-5 align-items-center">
        <div class="col-lg-5 text-center">
          <div style="background:var(--sup-bg-light);border-radius:16px;padding:2.5rem;display:inline-flex;align-items:center;justify-content:center;width:100%;min-height:320px;">
            @if (!string.IsNullOrEmpty(heroImg))
            {
              <img src="@heroImg" alt="@Model.Name" style="max-height:280px;max-width:100%;object-fit:contain;filter:drop-shadow(0 8px 24px rgba(0,0,0,.15));" />
            }
            else
            {
              <span class="text-muted" style="opacity:.4;">@Model.Name</span>
            }
          </div>
          <div class="mt-4 d-flex flex-column gap-2">
            <a class="btn-suprema justify-content-center" asp-controller="Contact" asp-action="Index">
              @L["Nav.RequestQuote"]
            </a>
            @if (Model.DatasheetUrl is not null)
            {
              <a class="btn-outline-suprema justify-content-center" href="@Model.DatasheetUrl" target="_blank" rel="noopener">
                @L["Common.Download"]
              </a>
            }
          </div>
        </div>
        <div class="col-lg-7">
          <div class="section-divider"></div>
          <h2 class="section-title mb-3">Overview</h2>
          <p style="font-size:1.05rem;line-height:1.85;color:var(--sup-muted);font-weight:300;">@Model.Summary</p>
        </div>
      </div>
    </div>
  </section>
}

@* â”€â”€ Key features â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ *@
@if (Model.Features.Count > 0)
{
  <section id="features" class="section-lg section-light">
    <div class="container">
      <div class="text-center mb-5 reveal">
        <div class="section-divider"></div>
        <h2 class="section-title">@L["Products.KeyFeatures"]</h2>
      </div>
      <div class="row g-4">
        @{int fi = 0;}
        @foreach (var f in Model.Features)
        {
          <div class="col-sm-6 col-lg-4 reveal reveal-delay-@((fi % 3) + 1)">
            <div class="feature-item h-100">
              <div class="mb-3" style="width:44px;height:44px;background:rgba(161,41,68,.1);border-radius:50%;display:flex;align-items:center;justify-content:center;">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M16.7 5.3l-8.4 8.4-4-4" stroke="#a12944" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
              <h6 class="fw-bold mb-1">@f.Title</h6>
              <p class="mb-0" style="font-size:.88rem;color:var(--sup-muted);font-weight:300;line-height:1.65;">@f.Description</p>
            </div>
          </div>
          fi++;
        }
      </div>
    </div>
  </section>
}

@* â”€â”€ Specifications â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ *@
@if (Model.Specs.Count > 0)
{
  <section id="specifications" class="section-lg">
    <div class="container">
      <div class="text-center mb-5 reveal">
        <div class="section-divider"></div>
        <h2 class="section-title">@L["Products.Specifications"]</h2>
      </div>
      <div class="row g-4">
        @foreach (var group in Model.Specs)
        {
          <div class="col-lg-6 reveal">
            <div class="spec-table-wrap">
              <table class="spec-table-new w-100">
                <thead>
                  <tr><th colspan="2">@group.Title</th></tr>
                </thead>
                <tbody>
                  @foreach (var kv in group.Items)
                  {
                    <tr>
                      <td>@kv.Key</td>
                      <td>@kv.Value</td>
                    </tr>
                  }
                </tbody>
              </table>
            </div>
          </div>
        }
      </div>
    </div>
  </section>
}

@* â”€â”€ Related products â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ *@
@if (related.Count > 0)
{
  <section id="related" class="section-lg section-light">
    <div class="container">
      <div class="text-center mb-5 reveal">
        <div class="section-divider"></div>
        <h2 class="section-title">@L["Products.RelatedProducts"]</h2>
      </div>
      <div class="row g-4 justify-content-center">
        @foreach (var rp in related)
        {
          productImages.TryGetValue(rp.Slug, out var rpImg);
          <div class="col-sm-6 col-lg-3 reveal">
            <div class="card card-product h-100">
              <div class="card-img-top">
                @if (!string.IsNullOrEmpty(rpImg))
                { <img src="@rpImg" alt="@rp.Name" /> }
                else
                { <span class="text-muted small" style="opacity:.4;">@rp.Name</span> }
              </div>
              <div class="card-body px-3 pt-3 pb-2">
                <span class="card-tag mb-2 d-inline-block">@rp.CategorySlug.Replace("-", " ")</span>
                <h6 class="card-title">@rp.Name</h6>
                <p style="font-size:.82rem;color:var(--sup-muted);font-weight:300;">@rp.TagLine</p>
              </div>
              <div class="card-footer bg-transparent border-0 px-3 pb-3">
                <a href="/products/@rp.CategorySlug/@rp.Slug"
                   class="btn-outline-suprema btn-sm w-100 justify-content-center">@L["Common.LearnMore"]</a>
              </div>
            </div>
          </div>
        }
      </div>
    </div>
  </section>
}

@* â”€â”€ CTA â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ *@
<section class="cta-strip section-md text-center text-white">
  <div class="container reveal">
    <h3 class="fw-bold mb-3" style="font-size:clamp(1.4rem,2.5vw,2rem);letter-spacing:-0.025em;">
      Interested in @Model.Name for your organisation?
    </h3>
    <p class="mb-4" style="opacity:.75;font-weight:300;">
      Talk to our South Africa team â€” we respond within one business day.
    </p>
    <a class="btn-suprema" asp-controller="Contact" asp-action="Index">@L["Nav.RequestQuote"]</a>
  </div>
</section>

