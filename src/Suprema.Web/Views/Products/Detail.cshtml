@model Product
@inject Suprema.Core.Abstractions.IContentService Content
@{
    var cat = Content.GetCategory(Model.CategorySlug);
    ViewData["Title"] = Model.Name;
    ViewData["MetaDescription"] = Model.TagLine;
    var related = Model.RelatedSlugs
        .Select(s => Content.GetProduct(Model.CategorySlug, s))
        .Where(p => p is not null)
        .Cast<Product>()
        .ToList();
}

<section class="page-hero">
  <div class="container">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="breadcrumb-item"><a asp-controller="Products" asp-action="Index">Products</a></li>
        @if (cat is not null)
        {
          <li class="breadcrumb-item">
            <a asp-controller="Products" asp-action="Category" asp-route-category="@cat.Slug">@cat.Name</a>
          </li>
        }
        <li class="breadcrumb-item active">@Model.Name</li>
      </ol>
    </nav>
    <h1>@Model.Name</h1>
    <p class="text-muted mb-0">@Model.TagLine</p>
  </div>
</section>

<section class="py-5">
  <div class="container">
    <div class="row g-5">

      @* Left: hero image *@
      <div class="col-md-5">
        <div class="rounded-3 bg-light d-flex align-items-center justify-content-center mb-3"
             style="height:320px;">
          <span class="text-muted">PLACEHOLDER — @Model.Name hero image</span>
        </div>
        @if (Model.DatasheetUrl is not null)
        {
          <a class="btn btn-outline-suprema w-100" href="@Model.DatasheetUrl" target="_blank" rel="noopener">
            &#128196; @L["Common.Download"]
          </a>
        }
        <div class="mt-3">
          <a class="btn btn-suprema w-100 btn-lg" asp-controller="Contact" asp-action="Index">
            @L["Nav.RequestQuote"]
          </a>
        </div>
      </div>

      @* Right: copy + features *@
      <div class="col-md-7">
        <div class="mb-4">@Model.Summary</div>

        @if (Model.Features.Count > 0)
        {
          <h4 class="section-title mb-3">@L["Products.KeyFeatures"]</h4>
          <div class="row g-3 mb-4">
            @foreach (var f in Model.Features)
            {
              <div class="col-sm-6">
                <div class="d-flex gap-2">
                  <div class="feature-icon" style="font-size:1.3rem;min-width:28px;">&#10003;</div>
                  <div>
                    <div class="fw-bold small">@f.Title</div>
                    <div class="text-muted small">@f.Description</div>
                  </div>
                </div>
              </div>
            }
          </div>
        }
      </div>
    </div>

    @* Specs *@
    @if (Model.Specs.Count > 0)
    {
      <hr class="my-4" />
      <h4 class="section-title mb-3">@L["Products.Specifications"]</h4>
      <div class="row g-4">
        @foreach (var group in Model.Specs)
        {
          <div class="col-md-6">
            <h6 class="fw-bold text-suprema">@group.Title</h6>
            <table class="table table-sm spec-table">
              <tbody>
                @foreach (var kv in group.Items)
                {
                  <tr>
                    <th>@kv.Key</th>
                    <td>@kv.Value</td>
                  </tr>
                }
              </tbody>
            </table>
          </div>
        }
      </div>
    }

    @* Related products *@
    @if (related.Count > 0)
    {
      <hr class="my-4" />
      <h4 class="section-title mb-3">@L["Products.RelatedProducts"]</h4>
      <div class="row g-3">
        @foreach (var rp in related)
        {
          <div class="col-sm-6 col-lg-3">
            <div class="card card-product h-100">
              <div class="card-body">
                <h6 class="card-title">@rp.Name</h6>
                <p class="text-muted small">@rp.TagLine</p>
                <a href="/products/@rp.CategorySlug/@rp.Slug"
                   class="btn btn-outline-suprema btn-sm">@L["Common.LearnMore"]</a>
              </div>
            </div>
          </div>
        }
      </div>
    }
  </div>
</section>
