@model IReadOnlyList<Product>
@{
    var cat = (ProductCategory)ViewData["Category"]!;
    ViewData["Title"] = cat.Name;
    ViewData["MetaDescription"] = cat.Description;
}

<section class="page-hero">
  <div class="container">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="breadcrumb-item"><a asp-controller="Products" asp-action="Index">Products</a></li>
        <li class="breadcrumb-item active">@cat.Name</li>
      </ol>
    </nav>
    <h1>@cat.Name</h1>
    <p class="text-muted mb-0">@cat.Description</p>
  </div>
</section>

<section class="py-5">
  <div class="container">
    @if (!Model.Any())
    {
      <p class="text-muted">No products in this category yet.</p>
    }
    else
    {
      <div class="row g-4">
        @foreach (var product in Model)
        {
          <div class="col-sm-6 col-lg-4">
            <div class="card card-product h-100">
              <div class="card-img-top d-flex align-items-center justify-content-center bg-light" style="height:200px;">
                <span class="text-muted small">PLACEHOLDER — @product.Name</span>
              </div>
              <div class="card-body">
                @if (product.Featured)
                {
                  <span class="card-tag mb-2 d-inline-block" style="background:#fff3cd;color:#856404;">Featured</span>
                }
                <h5 class="card-title">@product.Name</h5>
                <p class="text-muted small">@product.TagLine</p>
              </div>
              <div class="card-footer bg-transparent border-0 pb-3">
                <a href="/products/@cat.Slug/@product.Slug"
                   class="btn btn-outline-suprema btn-sm w-100">@L["Common.LearnMore"]</a>
              </div>
            </div>
          </div>
        }
      </div>
    }
  </div>
</section>
