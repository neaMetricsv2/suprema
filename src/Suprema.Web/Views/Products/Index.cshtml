@model IReadOnlyList<ProductCategory>
@{
    ViewData["Title"] = "Products";
    ViewData["MetaDescription"] = "Browse Suprema South Africa's full range of access control, time & attendance and biometric solutions — enterprise-grade, locally supported.";
    var catImages = new System.Collections.Generic.Dictionary<string, string>
    {
        ["access-control"] = "/assets/images/access_control_visual.jpg",
        ["time-attendance"] = "/assets/images/bg_biostation_2a_1.jpg",
        ["biometrics"]      = "/assets/images/bg_biostation3_2.jpg"
    };
}

<section class="page-hero">
  <div class="container">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="breadcrumb-item active">Products</li>
      </ol>
    </nav>
    <h1>@L["Products.AllCategories"]</h1>
    <p class="page-hero-sub">Enterprise-grade biometric hardware, delivered and supported locally across South Africa.</p>
  </div>
</section>

<section class="section-lg">
  <div class="container">
    <div class="row g-4">
      @foreach (var cat in Model)
      {
        catImages.TryGetValue(cat.Slug, out var bgImg);
        <div class="col-md-4 reveal">
          <a href="/products/@cat.Slug" class="card-solution-grid d-block" style="min-height:320px;">
            <div class="sol-bg" style="background-image:url('@(bgImg ?? "/assets/images/section02-bg.jpg")');">
            </div>
            <div class="sol-body">
              <h5>@cat.Name</h5>
              <p>@cat.Description</p>
              <span class="btn-outline-white btn-sm mt-3 d-inline-flex">@L["Common.LearnMore"]</span>
            </div>
          </a>
        </div>
      }
    </div>
  </div>
</section>
