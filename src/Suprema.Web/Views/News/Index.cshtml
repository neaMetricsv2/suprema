@model IReadOnlyList<Article>
@{
    ViewData["Title"] = "News";
    ViewData["MetaDescription"] = "Latest news and updates from Suprema South Africa.";
}

<section class="page-hero">
  <div class="container">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="breadcrumb-item active">News</li>
      </ol>
    </nav>
    <h1>@L["News.Title"]</h1>
  </div>
</section>

<section class="py-5">
  <div class="container">
    @if (!Model.Any())
    {
      <p class="text-muted">No articles published yet.</p>
    }
    else
    {
      <div class="row g-4">
        @foreach (var article in Model)
        {
          <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm">
              <div class="d-flex align-items-center justify-content-center bg-light" style="height:180px;">
                <span class="text-muted small">PLACEHOLDER — article image</span>
              </div>
              <div class="card-body">
                <p class="text-muted small mb-1">
                  @L["News.Published"]: @article.PublishedUtc.ToString("d MMMM yyyy")
                  @if (article.Author is not null) { <span class="ms-2">— @article.Author</span> }
                </p>
                <h5 class="fw-bold">@article.Title</h5>
                <p class="text-muted small">@article.Excerpt</p>
                @foreach (var tag in article.Tags)
                {
                  <span class="card-tag me-1">@tag</span>
                }
              </div>
              <div class="card-footer bg-transparent border-0 pb-3">
                <a asp-controller="News" asp-action="Article" asp-route-slug="@article.Slug"
                   class="btn btn-outline-suprema btn-sm">@L["News.ReadMore"]</a>
              </div>
            </div>
          </div>
        }
      </div>
    }
  </div>
</section>
